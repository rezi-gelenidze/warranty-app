DB_HOST=localhost
DB_PORT=5432
DB_NAME=warranty
DB_USER=warranty
DB_PASSWORD=warranty

# Local RustFS. For Cloudflare R2 use:
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto, S3_CREATE_BUCKET=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=warranty-documents
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_CREATE_BUCKET=true
